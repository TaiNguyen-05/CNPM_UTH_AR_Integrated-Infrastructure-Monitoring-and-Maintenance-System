{
  "buildCommand": "cd Code/frontend && npm install && npm run build",
  "outputDirectory": "Code/frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/apispec.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/flasgger_static/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
